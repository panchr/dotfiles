# Rushy Panchal
# ~/.zshenv is sourced on all shells, not just interactive. PATH and other
# environment variables should be set up here.
#
# This file runs for every zsh process (including scripts and subshells), so it
# must stay fork-free: no $(...) command substitutions. $OSTYPE and the :A/:h
# path modifiers replace uname, readlink, dirname and realpath.

# Environment setup that must be performed before anything else.
# :A resolves the ~/.zshrc symlink to its real path (like realpath/readlink -f),
# and each :h strips a trailing path component, landing on the repository root.
_zshenv_rc="${ZDOTDIR:-$HOME}/.zshrc"
export DOTFILES="${_zshenv_rc:A:h:h}"
unset _zshenv_rc
case $OSTYPE in
darwin*)
    # /etc/zprofile and /etc/zshrc cost ~7ms per interactive shell: path_helper
    # is a fork, and /etc/zshrc forks `locale` and loads terminfo to bind a few
    # keys. no_global_rcs skips both; what they set up is replicated fork-free,
    # PATH and LANG here, COMBINING_CHARS and the key bindings in zshrc.
    setopt no_global_rcs
    # path_helper puts /etc/paths first, then /etc/paths.d/* in numeric order,
    # then whatever was already on PATH, dropping duplicates (-U does that).
    # $(<file) is read by zsh itself, without a fork; :# drops blank lines.
    typeset -U path
    _zshenv_paths=( ${${(f)"$(</etc/paths)"}:#} )
    for _zshenv_file in /etc/paths.d/*(N.n); do
        _zshenv_paths+=( ${${(f)"$(<$_zshenv_file)"}:#} )
    done
    path=( /opt/homebrew/bin $_zshenv_paths $path )
    # path_helper does the same for MANPATH, but only when it is already set.
    if [[ -n $MANPATH ]]; then
        typeset -U manpath
        _zshenv_paths=( ${${(f)"$(</etc/manpaths)"}:#} )
        for _zshenv_file in /etc/manpaths.d/*(N.n); do
            _zshenv_paths+=( ${${(f)"$(<$_zshenv_file)"}:#} )
        done
        # A trailing colon (Ghostty sets one) means "then the defaults" to
        # man(1); the array drops that empty element, so put it back.
        _zshenv_manpath_tail=${(M)MANPATH%:}
        manpath=( $_zshenv_paths $manpath )
        [[ -n $_zshenv_manpath_tail ]] && manpath+=( '' )
        unset _zshenv_manpath_tail
    fi
    unset _zshenv_paths _zshenv_file
    if [[ -o login && -z $LANG ]]; then
        export LANG=C.UTF-8
    fi
    ;;
linux*)
    # Ubuntu's /etc/zsh/zshrc otherwise runs a full, audited compinit before
    # ~/.zshrc gets a chance to run its own cached one.
    skip_global_compinit=1
    ;;
freebsd*)
    # do nothing
    ;;
esac

# Doom is typically installed here, so make the 'doom' CLI available everywhere.
if [[ -d ~/.config/emacs/bin ]]; then
    path=( ~/.config/emacs/bin $path )
fi

export EDITOR="emacsclient --alternate-editor='' --create-frame -nw"
export PAGER="less"

# Trust global mise configuration.
export MISE_TRUSTED_CONFIG_PATHS="$DOTFILES/misc/mise.toml"

# Increase max open files limit. On MacOS, this defaults to 256, which is very
# limiting.
ulimit -S -n 2048

# Themes for tools.
export BAT_THEME=OneHalfDark
export MOOR="-style=nordic -wrap -quit-if-one-screen -mousemode select -no-linenumbers"

# Use mcp-cli with Claude.
export ENABLE_EXPERIMENTAL_MCP_CLI=1
