# Rushy Panchal
# ~/.zshrc is only sourced for interactive shells.

# For profiling zsh, see: https://unix.stackexchange.com/a/329719/27109.
# Execute 'ZSH_PROFILE_RC=true zsh -i -c exit' and run 'zprof' to get the details.
if [[ -n "${ZSH_PROFILE_RC+1}" ]]; then
    zmodload zsh/zprof
fi

if [[ $TERM == "dumb" ]]; then
    # Set up a basic prompt.
    autoload -U colors
    autoload -Uz promptinit
    setopt PROMPT_SUBST
    PROMPT_CHAR="λ"
    PROMPT='%F{39}%m%f:%F{yellow}%~%f %F{214}$PROMPT_CHAR%f '

    # Skip all other configuration, which depends on there being a smarter
    # terminal.
    return
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

### Compiled caches ###
# _zshrc_compile keeps a compiled sibling of $1 fresh. zsh prefers file.zwc
# whenever it is at least as new as the source, but silently falls back to
# parsing the source if the .zwc was written by a different zsh build (Apple's
# /bin/zsh and Homebrew's zsh disagree), and a stale .zwc is still "newer" so
# it would never be rebuilt. `zcompile -t` reads only the header, so check it.
_zshrc_compile() {
    if [[ "$1.zwc" -nt "$1" ]] && zcompile -t -- "$1.zwc" >/dev/null 2>&1; then
        return
    fi
    zcompile -R -- "$1"
}

# _zshrc_source_compiled sources a file through its compiled form.
_zshrc_source_compiled() {
    _zshrc_compile "$1"
    source "$1"
}

### Completions ###
# compinit costs ~4.5ms even from a compiled dump (it registers ~1500
# completion functions), and nothing needs it until the first completion.
# Tab runs `expand-or-complete`, directly or as fzf's fallback, so that widget
# is shadowed by one that initialises compsys and then completes. compinit
# redefines the widget itself as part of its setup, and the builtin is
# restored first so nothing recurses if it does not. `compdef` calls made in
# the meantime (plugins register completions at load) are queued and replayed.
_zshrc_compdef_queue=()
compdef() { _zshrc_compdef_queue+=( "${(j: :)${(q)@}}" ) }

_zshrc_compinit() {
    autoload -Uz compinit
    # compinit's default audit of every fpath directory costs ~10ms, so trust
    # the cached dump (-C) and only rebuild it once a day. compinit only
    # rewrites the dump when it changes, so remove it first; otherwise its
    # mtime never advances and the full audit runs every day.
    local dump="${ZDOTDIR:-$HOME}/.zcompdump" stale
    for stale in $dump(N.mh+24); do
        rm -f -- "$stale"
        compinit -d "$dump"
        stale=done
    done
    [[ $stale == done ]] || compinit -C -d "$dump"
    # Parsing the ~50KB dump text is another ~6ms, so keep a compiled copy.
    _zshrc_compile "$dump"

    local args
    for args in "${_zshrc_compdef_queue[@]}"; do
        eval "compdef $args"
    done
    unset _zshrc_compdef_queue
}

_zshrc_lazy_complete() {
    zle -A .expand-or-complete expand-or-complete
    _zshrc_compinit
    # compinit replaces every shadow with a compsys widget; if one is still
    # ours, compinit failed, so stop rather than recurse.
    [[ $widgets[$WIDGET] == user:_zshrc_lazy_complete ]] && return 1
    zle "$WIDGET"
}
zle -N expand-or-complete _zshrc_lazy_complete

# compinit also binds these chords (its fixed defaults, as recorded in the
# dump), which would otherwise be dead until the first Tab. Bind each to a
# shadow now; the real widgets exist once compinit has run.
for _zshrc_key _zshrc_widget in \
    '^X^R' _read_comp '^X?' _complete_debug '^XC' _correct_filename \
    '^Xa' _expand_alias '^Xc' _correct_word '^Xd' _list_expansions \
    '^Xe' _expand_word '^Xh' _complete_help '^Xm' _most_recent_file \
    '^Xn' _next_tags '^Xt' _complete_tag '^X~' _bash_list-choices \
    '^[,' _history-complete-newer '^[/' _history-complete-older \
    '^[~' _bash_complete-word; do
    zle -N "$_zshrc_widget" _zshrc_lazy_complete
    bindkey "$_zshrc_key" "$_zshrc_widget"
done
unset _zshrc_key _zshrc_widget

# menu-style completion
zstyle ':completion:*' menu select

# Emacs-style key bindings
bindkey -e
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word

# search forwards/backwards in history
# ZLE puts the terminal in application mode, where arrows arrive as ^[OA/^[OB
# (terminfo kcuu1/kcud1) rather than ^[[A/^[[B, so bind both forms.
bindkey "^[[A" history-beginning-search-backward
bindkey "^[OA" history-beginning-search-backward
bindkey "^[[B" history-beginning-search-forward
bindkey "^[OB" history-beginning-search-forward

# Home, End and Delete. macOS's /etc/zshrc bound these from terminfo, but
# zshenv skips that file; these are the sequences the terminals in use send
# (xterm-style ^[OH/^[[H from Ghostty, VT-style ^[[1~ from tmux) plus rxvt's.
bindkey "^[[H" beginning-of-line
bindkey "^[OH" beginning-of-line
bindkey "^[[1~" beginning-of-line
bindkey "^[[7~" beginning-of-line
bindkey "^[[F" end-of-line
bindkey "^[OF" end-of-line
bindkey "^[[4~" end-of-line
bindkey "^[[8~" end-of-line
bindkey "^[[3~" delete-char

# Correctly display UTF-8 with combining characters. /etc/zshrc forked
# `locale` to decide this; the variables it consults are enough.
if [[ ${(L)${LC_ALL:-${LC_CTYPE:-$LANG}}} == *utf(-|)8* ]]; then
    setopt COMBINING_CHARS
fi

# Move tty suspend from ctrl-z to ctrl-b: ctrl-z is the tmux prefix, and
# hitting it outside tmux by mistake otherwise backgrounds the foreground
# program. Only affects line-discipline susp, so zsh ZLE / tmux / full-screen
# TUIs (vim, less, ...) keep their own ctrl-b bindings.
if [[ -t 0 ]]; then
    stty susp '^B'
fi

# History settings
HISTFILE="$HOME/.zsh_history"
HISTSIZE=1000000
SAVEHIST=1000000
setopt EXTENDED_HISTORY       # record timestamp of command in HISTFILE
setopt HIST_EXPIRE_DUPS_FIRST # delete duplicates first when HISTFILE size exceeds HISTSIZE
setopt HIST_IGNORE_DUPS       # ignore duplicated commands history list
setopt HIST_SAVE_NO_DUPS	  # do not save duplicated commands in HISTFILE
setopt HIST_REDUCE_BLANKS     # remove superfluous blanks from each command
setopt HIST_VERIFY            # show command with history expansion to user before running it
setopt APPEND_HISTORY 	      # append to the history file, don't overwrite it
setopt INC_APPEND_HISTORY     # add commands to HISTFILE immediately in order of execution
setopt SHARE_HISTORY          # share command history data

# SHARE_HISTORY imports other sessions' entries at the end of every line read,
# empty ones included, and only touches the file when its size or mtime
# changed. That is the same moment a precmd hook would run, so no `fc -R`
# there is needed: it cost ~2ms per prompt and, lacking -I, re-appended the
# whole file to the in-memory list each time.
autoload -Uz add-zsh-hook

# zsh caches $PATH lookups in a hash table, so a CLI installed mid-session
# stays invisible to completion and to syntax highlighting (which reads
# $commands) until the table is rebuilt. Rebuilding is lazy but costs ~3ms
# (2900 commands over 21 directories), paid by whatever touches $commands
# next, usually the highlighter on the first keystroke after the prompt. So
# rehash only when a PATH directory's mtime changed, which is what installing
# a command does; stat-ing them all costs ~40µs. (N/) skips missing entries,
# which would otherwise abort zstat.
#
# Note the named hook function: `add-zsh-hook precmd () { ... }` is zsh's
# multi-name definition syntax, which defines add-zsh-hook and precmd rather
# than registering a hook, clobbering add-zsh-hook for everything sourced
# later.
zmodload -F zsh/stat b:zstat
_zshrc_rehash_commands() {
    local -a mtimes
    zstat -A mtimes +mtime -- $^path(N/)
    if [[ "$mtimes" != "$_zshrc_path_mtimes" ]]; then
        _zshrc_path_mtimes="$mtimes"
        rehash
    fi
}
add-zsh-hook precmd _zshrc_rehash_commands

# Incognito mode: keeps existing history searchable but new commands
# stay in memory only and don't touch the real history file. Persists
# across child shells via the INCOGNITO env var; in tmux, also propagates
# to new panes/windows in the current session.
incognito() {
    unsetopt SHARE_HISTORY INC_APPEND_HISTORY APPEND_HISTORY
    HISTFILE=/dev/null
    SAVEHIST=0
    typeset -gi _INCOGNITO=1
    export INCOGNITO=1
    if [[ -n "$TMUX" ]] && command -v tmux >/dev/null; then
        tmux set-environment INCOGNITO 1 2>/dev/null
    fi
    # The prompt_char segment's CONTENT_EXPANSION reads $_INCOGNITO each render,
    # so the prompt symbol disappears automatically on the next prompt.
}

# unincognito clears the incognito marker from this shell, child env, and the
# tmux session so future shells/panes start fresh. The current shell's history
# stays in-memory-only to avoid leaking already-typed incognito commands to
# disk -- run `exec zsh` if you want a fully clean shell.
unincognito() {
    unset _INCOGNITO INCOGNITO
    if [[ -n "$TMUX" ]] && command -v tmux >/dev/null; then
        tmux set-environment -u INCOGNITO 2>/dev/null
    fi
}

# Use fzf for fuzzy history search. Loaded from the ZLE idle hook below, since
# it only defines widgets and key bindings.
_zshrc_load_fzf() {
    # Locate fzf by walking $path rather than via $commands[fzf]: the first
    # $commands access hashes every directory on PATH (~3ms), work better
    # left to whoever needs the whole table.
    local fzf= dir cache
    for dir in $path; do
        if [[ -x "$dir/fzf" ]]; then
            fzf="$dir/fzf"
            break
        fi
    done
    [[ -n "$fzf" ]] || return

    # `fzf --zsh` prints static key-binding code, but forking fzf to ask for it
    # costs ~5ms per shell. Cache it until the fzf binary itself changes.
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/fzf.zsh"
    if [[ ! "$cache" -nt "$fzf" ]]; then
        mkdir -p -- "${cache:h}"
        "$fzf" --zsh >"$cache"
    fi
    # fzf's completion setup forks `bindkey '^I'` to learn the fallback tab
    # widget unless told; that is the widget the lazy compinit above shadows.
    fzf_default_completion=expand-or-complete
    _zshrc_source_compiled "$cache"
    # Use ctrl-y to copy the command when searching history.
    export FZF_CTRL_R_OPTS="
    --bind 'ctrl-y:execute-silent(echo -n {2..} | pbcopy)+abort'
    --color header:italic
    --header 'Press CTRL-Y to copy command into clipboard'"
    # Preview file content using bat (https://github.com/sharkdp/bat)
    export FZF_CTRL_T_OPTS="
    --walker-skip .git,node_modules,target
    --preview 'bat -n --color=always {}'
    --bind 'ctrl-/:change-preview-window(down|hidden|)'"
    # Wrap fzf's ctrl+r to import entries other sessions wrote while this
    # prompt sat idle (-I: only entries not already in memory).
    fzf-history-widget-with-reload() { fc -RI; fzf-history-widget }
    zle -N fzf-history-widget-with-reload
    bindkey '^R' fzf-history-widget-with-reload
}

### User configuration ###
export CLICOLOR=1

export PAGER='less -R'
alias yaml="$PAGER"
if command -v moor >/dev/null; then
    export PAGER='moor'
    alias less="$PAGER"
    alias yaml="$PAGER -lang=yaml"

fi
if command -v bat >/dev/null; then
    alias bat="bat --plain"
    # ...This hacky mess is recommended by bat.
    # See: https://github.com/sharkdp/bat?tab=readme-ov-file#man.
    export MANPAGER="sh -c 'awk '\''{ gsub(/\x1B\[[0-9;]*m/, \"\", \$0); gsub(/.\x08/, \"\", \$0); print }'\'' | bat -p -lman'"
fi

# Load functions.
_zshrc_source_compiled ~/.sh_functions

# Aliases
alias reload="exec zsh"
alias grep="grep --color=auto"
alias htop="btop" # btop is a better replacement for htop
alias edit="$EDITOR"
alias view="view_file"

case $OSTYPE in
    darwin*)
	alias  ls='ls -a -G'
	export LSCOLORS=HxfxBxdx
	# The rest of what /etc/zshrc (skipped by zshenv) did: keep the `log`
	# builtin from shadowing /usr/bin/log, and Terminal.app's integration.
	disable log
	if [[ -r "/etc/zshrc_$TERM_PROGRAM" ]]; then
	    source "/etc/zshrc_$TERM_PROGRAM"
	fi
    ;;
    linux*)
	alias ls='ls -a --color=auto'
	export LS_COLORS='no=00;36:di=01;37:ex=01;31:ln=00;35'
	export LESS_TERMCAP_mb=$'\E[1;31m'     # begin bold
	export LESS_TERMCAP_md=$'\E[1;36m'     # begin blink
	export LESS_TERMCAP_me=$'\E[0m'        # reset bold/blink
	export LESS_TERMCAP_so=$'\E[01;44;33m' # begin reverse video
	export LESS_TERMCAP_se=$'\E[0m'        # reset reverse video
	export LESS_TERMCAP_us=$'\E[1;32m'     # begin underline
	export LESS_TERMCAP_ue=$'\E[0m'        # reset underline
	export GROFF_NO_SGR=1                  # for konsole and gnome-terminal
    ;;
    freebsd*)
	# do nothing
    ;;
esac

# Environment variables (never committed).
if [ -f ~/.env_variables ]; then
    source ~/.env_variables
fi

# Local Configuration (never commited).
if [ -f ~/.zshrc.local ]; then
    source ~/.zshrc.local
fi

# ghostty integration. Ghostty injects this only into shells it spawns
# directly, so tmux panes and `exec zsh` need it sourced here. Parsing the
# 22KB file costs ~0.6ms and the app bundle is read-only, so a copy is kept
# and compiled in the cache, refreshed whenever a Ghostty update changes it.
if [[ -n "${GHOSTTY_RESOURCES_DIR}" ]]; then
    _zshrc_ghostty="${GHOSTTY_RESOURCES_DIR}/shell-integration/zsh/ghostty-integration"
    _zshrc_ghostty_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/ghostty-integration.zsh"
    if [[ ! "$_zshrc_ghostty_cache" -nt "$_zshrc_ghostty" ]]; then
        mkdir -p -- "${_zshrc_ghostty_cache:h}"
        print -r -- "$(<"$_zshrc_ghostty")" >"$_zshrc_ghostty_cache"
    fi
    _zshrc_source_compiled "$_zshrc_ghostty_cache"
    unset _zshrc_ghostty _zshrc_ghostty_cache
fi

# Mise, the package manager. See: https://mise.jdx.dev/.
# Shims are used instead of `mise activate zsh` to avoid its ~22ms per-prompt
# hook. `mise activate zsh --shims` itself only prints a PATH prepend of the
# shims directory, and forking mise to ask costs ~13ms, so prepend it directly.
_zshrc_mise_shims="${MISE_SHIMS_DIR:-${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims}"
if [[ -d "$_zshrc_mise_shims" ]]; then
    path=( "$_zshrc_mise_shims" $path )
fi
unset _zshrc_mise_shims

# Enable the powerlevel10k theme.
# p10k detects SSH from $SSH_CLIENT/$SSH_TTY/$SSH_CONNECTION, then falls back
# to forking `who -m` (~2.5ms) for the rare case of `su` on a remote host
# dropping those variables. Local terminals never hit that case, so answer it
# up front; p10k skips the probe when these two are already set for this TTY.
# Child shells (tmux panes) inherit them with a stale TTY, so re-answer there
# too rather than only when unset. A parent that did detect SSH is trusted.
if [[ $P9K_SSH != 1 && -z $SSH_CLIENT && -z $SSH_TTY && -z $SSH_CONNECTION ]]; then
    typeset -gix P9K_SSH=0
    typeset -gx _P9K_SSH_TTY=$TTY
fi
if [[ -f "$DOTFILES/zsh/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
    source "$DOTFILES/zsh/powerlevel10k/powerlevel10k.zsh-theme"
fi

# To customize prompt, run `p10k configure` or edit p10k.zsh.
if [[ -f "$DOTFILES/zsh/p10k.zsh" ]]; then
    _zshrc_source_compiled "$DOTFILES/zsh/p10k.zsh"
fi

# Re-apply incognito mode if inherited from a parent shell or tmux session.
if [[ "$INCOGNITO" == "1" ]]; then
    incognito
fi

# Syntax highlighting. Must be sourced after every other widget is defined.
_zshrc_load_syntax_highlighting() {
    local dir="$DOTFILES/zsh/zsh-syntax-highlighting" f
    [[ -f "$dir/zsh-syntax-highlighting.zsh" ]] || return
    # Parsing the plugin's source costs ~4ms. It sources its highlighters
    # itself, so compile those too; the plugin's .gitignore already excludes
    # .zwc files.
    for f in "$dir/zsh-syntax-highlighting.zsh" "$dir"/highlighters/*/*-highlighter.zsh(N); do
        _zshrc_compile "$f"
    done
    source "$dir/zsh-syntax-highlighting.zsh"
    ZSH_HIGHLIGHT_STYLES[path]='none'
}

# fzf's bindings and syntax highlighting are only useful once the line editor
# is taking input, and highlighting is re-applied on every redraw, so neither
# needs to load before the first prompt. Both load from a one-shot `zle -F`
# handler on an always-readable fd: zle calls it as soon as it first waits for
# input, after the prompt is drawn and before the first keystroke is read.
# Shells without ZLE (scripts, `zsh -i -c`) have no use for either.
_zshrc_zle_idle_init() {
    local fd=$1
    zle -F "$fd"
    exec {fd}<&-
    _zshrc_load_fzf
    _zshrc_load_syntax_highlighting
    unfunction _zshrc_load_fzf _zshrc_load_syntax_highlighting _zshrc_zle_idle_init
}
if [[ -o zle ]] && exec {_zshrc_zle_fd}</dev/null; then
    zle -F "$_zshrc_zle_fd" _zshrc_zle_idle_init
    unset _zshrc_zle_fd
fi

# Keep a compiled copy of this file as well; zsh prefers ~/.zshrc.zwc on the
# next startup as long as it is not older than ~/.zshrc, so editing this file
# simply triggers a recompile on the following startup.
_zshrc_compile "${ZDOTDIR:-$HOME}/.zshrc"

if [[ -n "${ZSH_PROFILE_RC+1}" ]]; then
    zprof
fi
